DATABASE_URL=postgresql+psycopg://idp:idp@localhost:5432/idp

# Authoring LLM (used to suggest fields and assemble the VLM prompt)
# Choose one: gemma | openai
LLM_PROVIDER=gemma

# Gemma — self-hosted HTTP endpoint (vLLM / Ollama / TGI compatible)
GEMMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:12b
GEMMA_API_KEY=

# OpenAI / GPT-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
